# ==============================================================================================
# CELL 3: DATA CLEANING, STANDARDIZATION, AND SCHEMA VALIDATION
# ==============================================================================================

def clean_and_validate_layoffs(df: pd.DataFrame) -> pd.DataFrame:
    """
    Cleans raw layoff records, validates schema integrity, parses temporal indicators,
    and categorizes operational metrics.
    """
    df_clean = df.copy()

    # 1. String Standardization and Whitespace Stripping
    text_cols = ['company', 'parent_company', 'hq_country', 'industry', 'sub_industry', 
                 'reported_reason_category', 'ai_involvement_type', 'confidence_level']
    for col in text_cols:
        if col in df_clean.columns:
            df_clean[col] = df_clean[col].astype(str).str.strip()

    # 2. Datetime Parsing & Temporal Features
    df_clean['announcement_date'] = pd.to_datetime(df_clean['announcement_date'], format='%Y-%m-%d', errors='coerce')
    df_clean['year'] = df_clean['announcement_date'].dt.year.astype(int)
    df_clean['month'] = df_clean['announcement_date'].dt.month.astype(int)
    df_clean['year_month'] = df_clean['announcement_date'].dt.to_period('M').astype(str)
    df_clean['quarter'] = df_clean['announcement_date'].dt.quarter.astype(int)
    df_clean['year_quarter'] = df_clean['year'].astype(str) + '-Q' + df_clean['quarter'].astype(str)

    # 3. Numeric Types and Bounds
    df_clean['employees_affected'] = pd.to_numeric(df_clean['employees_affected'], errors='coerce').fillna(0).astype(int)
    df_clean['headcount_pct'] = pd.to_numeric(df_clean['headcount_pct'], errors='coerce').fillna(0.0)

    # 4. Standardize Geographic Regions
    region_mapping = {
        'United States': 'North America',
        'India': 'South Asia',
        'Ireland': 'Europe'
    }
    df_clean['geographic_region'] = df_clean['hq_country'].map(region_mapping).fillna('Other')

    # 5. Sanity Check: Ensure no duplicate events exist
    duplicates = df_clean.duplicated(subset=['company', 'announcement_date', 'sub_industry']).sum()
    if duplicates > 0:
        df_clean = df_clean.drop_duplicates(subset=['company', 'announcement_date', 'sub_industry'], keep='first')

    # Sort chronological
    df_clean = df_clean.sort_values(by='announcement_date').reset_index(drop=True)
    return df_clean

# Execute cleaning
