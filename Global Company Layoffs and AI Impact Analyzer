# CELL 9: MACHINE LEARNING: NLP CLASSIFICATION OF EXECUTIVE RATIONALE STATEMENTS
# ==============================================================================================
# Defensible ML Task: Classifying public executive statements into restructuring drivers:
# - 'Overhiring & Macro Downturn'
# - 'Strategic AI Reallocation'
# - 'Cost Discipline & Margin Focus'
# - 'Crisis & Governance Restructure'

# Text preprocessing and dataset preparation
nlp_data = df[df['employees_affected'] > 0][['detailed_public_reason', 'reported_reason_category', 'year']].copy()

# Simplify into 4 defensible target classes
target_map = {
    'Macroeconomic & Pandemic Overhiring': 'Macro & Overhiring',
    'Strategic Reallocation & AI Focus': 'Strategic AI Pivot',
    'Operational Efficiency & Restructuring': 'Efficiency & Restructure',
    'Cost Discipline & Margin Focus': 'Cost Discipline',
    'M&A Integration & Divestiture': 'Efficiency & Restructure',
    'Startup Crisis & Regulatory Action': 'Crisis & Governance',
    'Performance Screening & Qualification': 'Efficiency & Restructure'
}
nlp_data['target_class'] = nlp_data['reported_reason_category'].map(target_map)

# Feature Extraction: TF-IDF Vectorizer with unigrams and bigrams
tfidf = TfidfVectorizer(stop_words='english', ngram_range=(1, 2), max_features=120)
X_tfidf = tfidf.fit_transform(nlp_data['detailed_public_reason'])
y = nlp_data['target_class']

# Fit Logistic Regression Classifier with balanced class weights
clf = LogisticRegression(random_state=RANDOM_STATE, class_weight='balanced', max_iter=200)

# Stratified 3-Fold Cross Validation (Defensible for small sample text benchmarking)
cv = StratifiedKFold(n_splits=3, shuffle=True, random_state=RANDOM_STATE)
cv_scores = cross_val_score(clf, X_tfidf, y, cv=cv, scoring='accuracy')

# Fit model on entire verified corpus to inspect vocabulary importances
clf.fit(X_tfidf, y)
y_pred = clf.predict(X_tfidf)

print("=" * 80)
print("NLP EXECUTIVE RATIONALE CLASSIFICATION BENCHMARK")
print("=" * 80)
print(f"Cross-Validation Accuracy (Stratified 3-Fold): {cv_scores.mean():.2f} (+/- {cv_scores.std():.2f})")
print(f"Overall In-Sample Classification Accuracy:    {accuracy_score(y, y_pred):.2f}")
print("-" * 80)
print("Classification Report:")
print(classification_report(y, y_pred, zero_division=0))
print("=" * 80)

# Extract Top Linguistic Indicators (Feature Importances) for AI Pivot vs Macro Overhiring
feature_names = np.array(tfidf.get_feature_names_out())
class_labels = clf.classes_

print("\nTOP DISCRIMINATIVE KEYWORDS BY EXECUTIVE RATIONALE CATEGORY:")
print("-" * 80)
for i, label in enumerate(class_labels):
    top_indices = np.argsort(clf.coef_[i])[-4:][::-1]
    top_words = feature_names[top_indices]
    print(f"[{label}]: {', '.join(top_words)}")
print("=" * 80)

# Visualizing Confusion Matrix Heatmap
cm = confusion_matrix(y, y_pred, labels=class_labels)
plt.figure(figsize=(8, 6))
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=class_labels, yticklabels=class_labels)
plt.title('Confusion Matrix: NLP Executive Statement Classifier', fontsize=12, weight='bold', pad=12)
plt.xlabel('Predicted Rationale', fontsize=10, weight='bold')
plt.ylabel('Ground Truth Category', fontsize=10, weight='bold')
plt.xticks(rotation=30, ha='right')
plt.tight_layout()
plt.show()

